PORT=4783
LENS_NETWORK="testnet" # mainnet, testnet, staging
SLICE_API_URL="https://slice-api-indol.vercel.app/"

# Frontend: Vite-exposed base URL for backend API (Vite only exposes VITE_* vars to client)
